# Copy this file to .env and fill in your real values.
# Never commit the real .env file — it holds secret keys.

# ── Stripe ──
# From https://dashboard.stripe.com/apikeys — use a test key (sk_test_...)
# until you're ready to go live (sk_live_...).
STRIPE_SECRET_KEY=sk_test_YOUR_SECRET_KEY_HERE

# ── PayPal ──
# From https://developer.paypal.com — create an app to get these.
# Use your Sandbox app's credentials while testing.
PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_PAYPAL_CLIENT_SECRET

# "sandbox" for testing, "live" once you're ready for real payments
PAYPAL_ENV=sandbox

# ── Server ──
PORT=3001
